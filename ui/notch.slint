// Notch UI: one black shape against a screen edge that morphs between states.

export { Settings } from "settings.slint";

export global Theme {
    out property <color> surface: #000000;
    out property <color> text: #ffffff;
    out property <color> muted: #8e8e93;
    out property <color> track: #2c2c2e;
    out property <color> claude: #d97757;
    out property <color> chatgpt: #10a37f;
    out property <color> gemini: #4c8df6;
    out property <color> good: #30d158;
    out property <color> warn: #ff9f0a;
    out property <color> bad: #ff453a;
    // Segoe UI digits are tabular by default, so numbers don't jitter.
    out property <string> font: "Segoe UI Variable";
}

component Bar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill: Theme.text;
    height: 2px;
    border-radius: 1px;
    background: Theme.track;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.fraction, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> fraction;
    spacing: 5px;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Bar {
        fraction: root.fraction;
    }
}

component Pair inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 5px;

    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// A label over its value, for the narrow notch on a side edge.
component StackedPair inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 1px;

    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    // Until armed the button ignores clicks and fills up as `progress` runs from 0 to 1.
    in property <bool> armed: true;
    in property <float> progress: 1;
    callback clicked();
    width: max(68px, label-text.preferred-width + 28px);
    height: 28px;
    border-radius: 14px;
    border-width: self.primary ? 0 : 1px;
    border-color: #3a3a3c;
    clip: true;
    background: !self.armed ? (self.primary ? #3a3a3c : transparent)
        : self.primary
        ? (touch.pressed ? #d1d1d6 : touch.has-hover ? #f2f2f7 : #ffffff)
        : (touch.pressed ? #3a3a3c : touch.has-hover ? #2c2c2e : transparent);
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.armed;
    accessible-action-default => {
        root.clicked();
    }

    if !root.armed: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        background: root.primary ? #8e8e93 : #2c2c2e;
    }

    label-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary && root.armed ? #000000 : Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.armed;
        clicked => {
            root.clicked();
        }
    }
}

component LinkButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: link-text.preferred-width;
    height: 28px;
    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => {
        root.clicked();
    }

    link-text := Text {
        height: parent.height;
        text: root.label;
        color: touch.has-hover ? Theme.text : Theme.muted;
        font-family: Theme.font;
        font-size: 11px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Dot inherits Rectangle {
    in property <color> fill;
    width: 6px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.fill;
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    width: badge-text.preferred-width + 10px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 15px;
        border-width: 1px;
        border-color: #3a3a3c;
        border-radius: 4px;

        badge-text := Text {
            text: root.label;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 9px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A thin circular progress ring; an empty track when the share is unknown (below 0).
component Ring inherits Rectangle {
    in property <float> fraction;
    in property <color> fill;
    in property <length> thickness: 2px;
    width: 14px;
    height: 14px;

    Rectangle {
        border-radius: self.width / 2;
        border-width: root.thickness;
        border-color: Theme.track;
    }

    // In viewbox units: the radius that centres the stroke on the track.
    property <float> radius: (root.width - root.thickness) / root.width * 50;
    // A full turn would start and end at the same point and draw nothing.
    property <angle> sweep-angle: min(root.fraction, 0.999) * 360deg;
    if root.fraction > 0.005: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.fill;
        stroke-width: root.thickness;

        MoveTo {
            x: 50;
            y: 50 - root.radius;
        }
        ArcTo {
            x: 50 + root.radius * sin(root.sweep-angle);
            y: 50 - root.radius * cos(root.sweep-angle);
            radius-x: root.radius;
            radius-y: root.radius;
            large-arc: root.fraction > 0.5;
            sweep: true;
        }
    }
}

// One usage limit: a ring, the share used, the window's name and when it resets.
component Gauge inherits HorizontalLayout {
    in property <float> fraction;
    in property <color> fill;
    in property <string> value;
    in property <string> label;
    in property <string> detail;
    spacing: 8px;
    accessible-role: progress-indicator;
    accessible-label: self.label;
    accessible-value: self.value;
    accessible-description: self.detail;

    Ring {
        width: 24px;
        height: 24px;
        thickness: 3px;
        fraction: root.fraction;
        fill: root.fill;
        y: (parent.height - self.height) / 2;
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            alignment: start;
            spacing: 5px;
            Text {
                text: root.value;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.detail;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 10px;
        }
    }
}

// What the user picked on a permission request.
export enum Choice { allow, deny, ask-in-app }

// Whose usage the notch shows.
export enum Provider { claude, chatgpt, gemini }

// The shown provider's status page; unknown until checked or when the check fails.
export enum Health { unknown, operational, degraded, down }

// The screen edge the notch sticks to; Rust picks the nearest one when it is dropped.
export enum NotchEdge { top, bottom, left, right }

// Why the notch is asking for attention.
export enum AlertKind { done, needs-input, usage-high, usage-critical }

// The provider's name and any incident, over its tokens and burn rate when known.
component ProviderInfo inherits VerticalLayout {
    in property <color> accent;
    in property <string> name;
    in property <Health> status;
    in property <bool> estimated;
    in property <string> detail;
    alignment: center;
    spacing: 3px;

    HorizontalLayout {
        spacing: 6px;
        Dot {
            fill: root.accent;
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        // Only incidents show; a healthy or unknown status takes no space.
        if root.status == Health.degraded || root.status == Health.down: Text {
            text: root.status == Health.down ? "· Outage" : "· Degraded";
            color: root.status == Health.down ? Theme.bad : Theme.warn;
            font-family: Theme.font;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.estimated: Badge {
            label: "ESTIMATED";
        }
    }
    if root.detail != "": Text {
        text: root.detail;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 10px;
    }
}

export component Notch inherits Window {
    // Loads as fractions in 0..1; text values are formatted by Rust.
    in property <float> cpu;
    in property <float> gpu;
    in property <float> ram;
    in property <float> vram;
    in property <string> ram-text: "-";
    in property <string> vram-text: "-";

    // AI usage of the selected provider; texts are formatted by Rust. Shares are
    // fractions in 0..1, or below 0 when unknown.
    in property <Provider> usage-provider;
    // The main limit (5-hour, plan or daily window).
    in property <float> usage-fraction: -1;
    in property <string> usage-short: "-";
    in property <string> usage-label;
    in property <string> usage-reset;
    // The weekly limit; its gauge shows only when the share is known.
    in property <float> weekly-fraction: -1;
    in property <string> weekly-short;
    in property <string> weekly-reset;
    // Tokens and burn rate from local logs, when there are any.
    in property <string> usage-detail;
    in property <Health> status;
    in property <bool> usage-estimated;
    private property <color> accent: self.usage-provider == Provider.chatgpt ? Theme.chatgpt
        : self.usage-provider == Provider.gemini ? Theme.gemini : Theme.claude;
    // The provider's colour, turning amber and then red as a limit runs out.
    pure function level(fraction: float) -> color {
        return fraction >= 0.95 ? Theme.bad : fraction >= 0.8 ? Theme.warn : self.accent;
    }
    private property <string> provider-name: self.usage-provider == Provider.chatgpt ? "ChatGPT"
        : self.usage-provider == Provider.gemini ? "Gemini" : "Claude";

    // The permission request on screen, if any. Rust keeps the queue.
    in property <bool> has-request;
    in property <int> request-id;
    in property <string> request-tool;
    in property <string> request-project;
    in property <string> request-detail;
    in property <int> request-more;
    // Whether Ctrl+Alt+Y and Ctrl+Alt+N answer the request; Rust claims the keys.
    in property <bool> shortcuts;
    callback decide(int, Choice);
    // Runs when a request card appears or goes, so Rust can claim or release the keys.
    callback request-shown-changed();
    changed has-request => {
        if self.has-request {
            self.arm();
        }
        self.request-shown-changed();
    }
    changed request-id => {
        self.arm();
    }

    // Allow and Deny ignore clicks for a moment after a card appears, so a click meant
    // for the window behind the notch cannot answer a request nobody has read.
    out property <bool> request-armed;
    private property <duration> arm-delay: 500ms;
    private property <duration> armed-from;
    private property <float> arming: self.request-armed ? 1
        : clamp((animation-tick() - self.armed-from) / self.arm-delay, 0, 1);
    function arm() {
        self.request-armed = false;
        self.armed-from = animation-tick();
        arm-timer.stop();
        arm-timer.start();
    }
    arm-timer := Timer {
        interval: root.arm-delay;
        running: false;
        triggered => {
            root.request-armed = true;
            self.stop();
        }
    }

    // Answers the request on the card, once it is armed; the buttons and shortcuts
    // both come through here.
    public function answer(choice: Choice) {
        if self.has-request && self.request-armed {
            self.decide(self.request-id, choice);
        }
    }

    // A short attention message; Rust sets and clears it.
    in property <bool> alert-active;
    in property <AlertKind> alert-kind;
    in property <string> alert-text;
    callback alert-clicked();

    // The size the shape is heading to. Rust clips the window to it, growing the region
    // at once and shrinking it after the animation, so clicks elsewhere pass through.
    out property <length> shape-width: self.target-width;
    out property <length> shape-height: self.target-height;
    // The size the shape has right now, partway through a morph.
    out property <length> drawn-width: pill.width;
    out property <length> drawn-height: pill.height;
    callback shape-changed();
    changed shape-width => {
        self.shape-changed();
    }
    changed shape-height => {
        self.shape-changed();
    }

    // Right-click on the notch; Rust shows a native menu because a Slint popup would be
    // clipped by the window region.
    callback menu-requested();

    // Dragging the notch with the left button: press, each move, and release. Rust moves
    // the window by how far the cursor travelled on screen, since the pill itself resizes
    // during a drag, and sticks it to an edge it is dropped near.
    in property <NotchEdge> edge;
    // While it is dragged, the notch is a free pill with every corner round.
    in property <bool> floating;
    callback drag-started();
    callback dragged();
    callback drag-ended();

    // Opens after a hover of a moment and closes after a short absence, so grazing the
    // edge or passing over it does not open it. A click opens it at once and keeps it
    // open until the next click, which closes it until the pointer leaves.
    private property <bool> expanded;
    private property <bool> pinned;
    private property <bool> dismissed;
    private property <bool> hovered: hover.has-hover;
    changed hovered => {
        if !self.hovered {
            self.dismissed = false;
        }
    }
    Timer {
        interval: 300ms;
        running: root.hovered && !root.expanded && !root.dismissed;
        triggered => {
            root.expanded = true;
        }
    }
    Timer {
        interval: 250ms;
        running: !root.hovered && root.expanded && !root.pinned;
        triggered => {
            root.expanded = false;
        }
    }
    function toggle-panel() {
        if self.expanded {
            self.expanded = false;
            self.pinned = false;
            self.dismissed = true;
        } else {
            self.expanded = true;
            self.pinned = true;
        }
    }

    private property <length> target-width: self.has-request ? request-width
        : self.alert-active ? alert-width
        : self.expanded ? open-width : idle-width;
    private property <length> target-height: self.has-request ? request-height
        : self.alert-active ? alert-height
        : self.expanded ? open-height : idle-height;
    // On a side edge the notch stands upright; requests and alerts stay wide, since their
    // text needs the room.
    private property <bool> vertical: self.edge == NotchEdge.left || self.edge == NotchEdge.right;
    private property <length> idle-width: self.vertical ? 54px : 250px;
    private property <length> idle-height: self.vertical ? 140px : 30px;
    private property <length> open-width: self.vertical ? 210px : 460px;
    private property <length> open-height: self.vertical ? 304px : 106px;
    // The idle and open sizes as drawn, easing into the other orientation when the notch
    // moves between a side edge and the top or bottom. The window region follows the
    // targets above instead, since re-clipping on every frame made the notch flicker.
    private property <length> drawn-idle-width: self.idle-width;
    private property <length> drawn-idle-height: self.idle-height;
    private property <length> drawn-open-width: self.open-width;
    private property <length> drawn-open-height: self.open-height;
    animate drawn-idle-width, drawn-idle-height, drawn-open-width, drawn-open-height {
        duration: 260ms;
        easing: ease-out;
    }
    private property <length> request-width: 460px;
    private property <length> request-height: 196px;
    private property <length> alert-width: 290px;
    private property <length> alert-height: 34px;

    title: "ai-notch";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // Fixed size large enough for the biggest state; only the shape is drawn.
    // Exposed because Rust positions the window before Slint knows its size.
    out property <length> fixed-width: 520px;
    out property <length> fixed-height: 320px;
    width: self.fixed-width;
    height: self.fixed-height;

    pill := Rectangle {
        // Against the window side that faces the screen edge, centered the other way, so
        // the notch always grows away from the edge.
        x: root.edge == NotchEdge.left ? 0
            : root.edge == NotchEdge.right ? parent.width - self.width
            : (parent.width - self.width) / 2;
        y: root.edge == NotchEdge.top ? 0
            : root.edge == NotchEdge.bottom ? parent.height - self.height
            : (parent.height - self.height) / 2;
        width: root.drawn-idle-width;
        height: root.drawn-idle-height;
        background: Theme.surface;
        // The side against the screen edge stays square; every other corner is round.
        // Each side's roundness runs from 0 (square) to 1 (round), easing between the two
        // as the notch is picked up and sticks again.
        property <length> corner: min(min(self.width, self.height) / 2, 22px);
        property <float> round-top: !root.floating && root.edge == NotchEdge.top ? 0 : 1;
        property <float> round-bottom: !root.floating && root.edge == NotchEdge.bottom ? 0 : 1;
        property <float> round-left: !root.floating && root.edge == NotchEdge.left ? 0 : 1;
        property <float> round-right: !root.floating && root.edge == NotchEdge.right ? 0 : 1;
        animate round-top, round-bottom, round-left, round-right {
            duration: 260ms;
            easing: ease-out;
        }
        border-top-left-radius: self.corner * min(self.round-top, self.round-left);
        border-top-right-radius: self.corner * min(self.round-top, self.round-right);
        border-bottom-left-radius: self.corner * min(self.round-bottom, self.round-left);
        border-bottom-right-radius: self.corner * min(self.round-bottom, self.round-right);
        clip: true;
        accessible-role: groupbox;
        accessible-label: "ai-notch";
        accessible-description: "CPU \{round(root.cpu * 100)}%, GPU \{round(root.gpu * 100)}%, \{root.provider-name} \{root.usage-short}";

        hover := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            moved => {
                root.dragged();
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.menu-requested();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-started();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    // Rust sets `floating` once the pointer moves far enough to drag, so
                    // a release without it is a click.
                    if !root.floating && !root.has-request && !root.alert-active {
                        root.toggle-panel();
                    }
                    root.drag-ended();
                }
            }
        }

        idle-row := Rectangle {
            if !root.vertical: HorizontalLayout {
                alignment: center;
                spacing: 18px;
                Pair {
                    label: "CPU";
                    value: "\{round(root.cpu * 100)}%";
                }
                Pair {
                    label: "GPU";
                    value: "\{round(root.gpu * 100)}%";
                }
                HorizontalLayout {
                    spacing: 6px;
                    Ring {
                        y: (parent.height - self.height) / 2;
                        fraction: root.usage-fraction;
                        fill: root.level(root.usage-fraction);
                    }
                    Text {
                        text: root.usage-short;
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            if root.vertical: VerticalLayout {
                alignment: center;
                spacing: 10px;
                StackedPair {
                    label: "CPU";
                    value: "\{round(root.cpu * 100)}%";
                }
                StackedPair {
                    label: "GPU";
                    value: "\{round(root.gpu * 100)}%";
                }
                VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: center;
                        Ring {
                            fraction: root.usage-fraction;
                            fill: root.level(root.usage-fraction);
                        }
                    }
                    Text {
                        text: root.usage-short;
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        detail := Rectangle {
            opacity: 0;

            if !root.vertical: VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 18px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 18px;
                    Stat {
                        label: "CPU";
                        value: "\{round(root.cpu * 100)}%";
                        fraction: root.cpu;
                    }
                    Stat {
                        label: "GPU";
                        value: "\{round(root.gpu * 100)}%";
                        fraction: root.gpu;
                    }
                    Stat {
                        label: "RAM";
                        value: root.ram-text;
                        fraction: root.ram;
                    }
                    Stat {
                        label: "VRAM";
                        value: root.vram-text;
                        fraction: root.vram;
                    }
                }

                HorizontalLayout {
                    spacing: 18px;
                    ProviderInfo {
                        horizontal-stretch: 1;
                        accent: root.accent;
                        name: root.provider-name;
                        status: root.status;
                        estimated: root.usage-estimated;
                        detail: root.usage-detail;
                    }
                    Gauge {
                        fraction: root.usage-fraction;
                        fill: root.level(root.usage-fraction);
                        value: root.usage-short;
                        label: root.usage-label;
                        detail: root.usage-reset;
                    }
                    if root.weekly-fraction >= 0: Gauge {
                        fraction: root.weekly-fraction;
                        fill: root.level(root.weekly-fraction);
                        value: root.weekly-short;
                        label: "week";
                        detail: root.weekly-reset;
                    }
                }
            }

            // The same, stacked: stats, then the provider and its limits.
            if root.vertical: VerticalLayout {
                alignment: center;
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 10px;

                Stat {
                    label: "CPU";
                    value: "\{round(root.cpu * 100)}%";
                    fraction: root.cpu;
                }
                Stat {
                    label: "GPU";
                    value: "\{round(root.gpu * 100)}%";
                    fraction: root.gpu;
                }
                Stat {
                    label: "RAM";
                    value: root.ram-text;
                    fraction: root.ram;
                }
                Stat {
                    label: "VRAM";
                    value: root.vram-text;
                    fraction: root.vram;
                }
                Rectangle {
                    height: 1px;
                    background: Theme.track;
                }
                ProviderInfo {
                    accent: root.accent;
                    name: root.provider-name;
                    status: root.status;
                    estimated: root.usage-estimated;
                    detail: root.usage-detail;
                }
                Gauge {
                    fraction: root.usage-fraction;
                    fill: root.level(root.usage-fraction);
                    value: root.usage-short;
                    label: root.usage-label;
                    detail: root.usage-reset;
                }
                if root.weekly-fraction >= 0: Gauge {
                    fraction: root.weekly-fraction;
                    fill: root.level(root.weekly-fraction);
                    value: root.weekly-short;
                    label: "week";
                    detail: root.weekly-reset;
                }
            }
        }

        request-view := VerticalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;
            accessible-role: groupbox;
            accessible-label: "Claude wants to use \{root.request-tool}";
            accessible-description: root.request-detail;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 6px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.claude;
                    }
                }
                Text {
                    text: "Claude wants to use \{root.request-tool}";
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.request-more > 0
                        ? "\{root.request-project}  +\{root.request-more}"
                        : root.request-project;
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            code-box := Rectangle {
                height: 104px;
                background: #161618;
                border-radius: 10px;
                clip: true;

                code := Flickable {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    content-height: max(self.height, command.preferred-height);

                    command := Text {
                        width: parent.width;
                        height: self.preferred-height;
                        vertical-alignment: top;
                        text: root.request-detail;
                        color: #e5e5ea;
                        font-family: "Cascadia Mono";
                        font-size: 11px;
                        wrap: char-wrap;
                    }
                }

                // One line of the command's font, to count the lines scrolled out of view.
                line := Text {
                    visible: false;
                    text: "0";
                    font-family: command.font-family;
                    font-size: command.font-size;
                }
                // The viewport moves up, below zero, as the command scrolls.
                property <int> hidden-lines: ceil(
                    (command.preferred-height + code.content-y - code.height) / line.preferred-height);
                // The full command must be read before it is allowed, so say what is cut off.
                if self.hidden-lines > 0: Rectangle {
                    y: parent.height - self.height;
                    height: 34px;
                    background: @linear-gradient(180deg, #16161800 0%, #161618 75%);

                    Text {
                        x: parent.width - self.width - 12px;
                        y: parent.height - self.height - 6px;
                        text: code-box.hidden-lines == 1 ? "+1 line"
                            : "+\{code-box.hidden-lines} lines";
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: 10px;
                        font-weight: 600;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                LinkButton {
                    label: "Open in app";
                    clicked => {
                        root.decide(root.request-id, Choice.ask-in-app);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.shortcuts: Text {
                    text: "Ctrl+Alt+Y · N";
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                PillButton {
                    label: "Deny";
                    armed: root.request-armed;
                    progress: root.arming;
                    clicked => {
                        root.answer(Choice.deny);
                    }
                }
                PillButton {
                    label: "Allow";
                    primary: true;
                    armed: root.request-armed;
                    progress: root.arming;
                    clicked => {
                        root.answer(Choice.allow);
                    }
                }
            }
        }

        alert-view := HorizontalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            alignment: center;
            spacing: 9px;
            padding-left: 18px;
            padding-right: 18px;
            accessible-role: button;
            accessible-label: root.alert-text;
            accessible-action-default => {
                root.alert-clicked();
            }

            Rectangle {
                width: 8px;
                // Only exists while an alert shows, so the pulse never runs in the background.
                if root.alert-active: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.alert-kind == AlertKind.done ? Theme.good
                        : root.alert-kind == AlertKind.usage-high ? Theme.warn
                        : root.alert-kind == AlertKind.usage-critical ? Theme.bad
                        : Theme.claude;
                    opacity: 0.55 + 0.45 * Math.sin(animation-tick() / 1100ms * 360deg);
                }
            }
            Text {
                text: root.alert-text;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Above the hover area, so a click on an alert focuses its session.
        TouchArea {
            enabled: root.alert-active && !root.has-request;
            clicked => {
                root.alert-clicked();
            }
        }

        states [
            request when root.has-request: {
                pill.width: root.request-width;
                pill.height: root.request-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                request-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate request-view.opacity { duration: 140ms; delay: 160ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate request-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            alert when root.alert-active: {
                pill.width: root.alert-width;
                pill.height: root.alert-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                alert-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate alert-view.opacity { duration: 140ms; delay: 140ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate alert-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            open when root.expanded: {
                pill.width: root.drawn-open-width;
                pill.height: root.drawn-open-height;
                idle-row.opacity: 0;
                detail.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; delay: 80ms; }
                    animate idle-row.opacity { duration: 80ms; }
                    animate detail.opacity { duration: 140ms; delay: 180ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate detail.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
        ]
    }
}
