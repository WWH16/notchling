// Notch UI: one black shape hanging from the top edge that morphs between states.

export { Settings } from "settings.slint";

export global Theme {
    out property <color> surface: #000000;
    out property <color> text: #ffffff;
    out property <color> muted: #8e8e93;
    out property <color> track: #2c2c2e;
    out property <color> claude: #d97757;
    out property <color> chatgpt: #10a37f;
    out property <color> gemini: #4c8df6;
    out property <color> good: #30d158;
    out property <color> warn: #ff9f0a;
    out property <color> bad: #ff453a;
    // Segoe UI digits are tabular by default, so numbers don't jitter.
    out property <string> font: "Segoe UI Variable";
}

component Bar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill: Theme.text;
    height: 2px;
    border-radius: 1px;
    background: Theme.track;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.fraction, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> fraction;
    spacing: 5px;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Bar {
        fraction: root.fraction;
    }
}

component Pair inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 5px;

    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 10px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    width: max(68px, label-text.preferred-width + 28px);
    height: 28px;
    border-radius: 14px;
    border-width: self.primary ? 0 : 1px;
    border-color: #3a3a3c;
    background: self.primary
        ? (touch.pressed ? #d1d1d6 : touch.has-hover ? #f2f2f7 : #ffffff)
        : (touch.pressed ? #3a3a3c : touch.has-hover ? #2c2c2e : transparent);

    label-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary ? #000000 : Theme.text;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component LinkButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: link-text.preferred-width;
    height: 28px;

    link-text := Text {
        height: parent.height;
        text: root.label;
        color: touch.has-hover ? Theme.text : Theme.muted;
        font-family: Theme.font;
        font-size: 11px;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Dot inherits Rectangle {
    in property <color> fill;
    width: 6px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.fill;
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    width: badge-text.preferred-width + 10px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 15px;
        border-width: 1px;
        border-color: #3a3a3c;
        border-radius: 4px;

        badge-text := Text {
            text: root.label;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 9px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A thin circular progress ring; an empty track when the share is unknown (below 0).
component Ring inherits Rectangle {
    in property <float> fraction;
    in property <color> fill;
    in property <length> thickness: 2px;
    width: 14px;
    height: 14px;

    Rectangle {
        border-radius: self.width / 2;
        border-width: root.thickness;
        border-color: Theme.track;
    }

    // In viewbox units: the radius that centres the stroke on the track.
    property <float> radius: (root.width - root.thickness) / root.width * 50;
    // A full turn would start and end at the same point and draw nothing.
    property <angle> sweep-angle: min(root.fraction, 0.999) * 360deg;
    if root.fraction > 0.005: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.fill;
        stroke-width: root.thickness;

        MoveTo {
            x: 50;
            y: 50 - root.radius;
        }
        ArcTo {
            x: 50 + root.radius * sin(root.sweep-angle);
            y: 50 - root.radius * cos(root.sweep-angle);
            radius-x: root.radius;
            radius-y: root.radius;
            large-arc: root.fraction > 0.5;
            sweep: true;
        }
    }
}

// One usage limit: a ring, the share used, the window's name and when it resets.
component Gauge inherits HorizontalLayout {
    in property <float> fraction;
    in property <color> fill;
    in property <string> value;
    in property <string> label;
    in property <string> detail;
    spacing: 8px;

    Ring {
        width: 24px;
        height: 24px;
        thickness: 3px;
        fraction: root.fraction;
        fill: root.fill;
        y: (parent.height - self.height) / 2;
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            alignment: start;
            spacing: 5px;
            Text {
                text: root.value;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.detail;
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 10px;
        }
    }
}

// What the user picked on a permission request.
export enum Choice { allow, deny, ask-in-app }

// Whose usage the notch shows.
export enum Provider { claude, chatgpt, gemini }

// The shown provider's status page; unknown until checked or when the check fails.
export enum Health { unknown, operational, degraded, down }

// Why the notch is asking for attention.
export enum AlertKind { done, needs-input, usage-high, usage-critical }

export component Notch inherits Window {
    // Loads as fractions in 0..1; text values are formatted by Rust.
    in property <float> cpu;
    in property <float> gpu;
    in property <float> ram;
    in property <float> vram;
    in property <string> ram-text: "-";
    in property <string> vram-text: "-";

    // AI usage of the selected provider; texts are formatted by Rust. Shares are
    // fractions in 0..1, or below 0 when unknown.
    in property <Provider> usage-provider;
    // The main limit (5-hour, plan or daily window).
    in property <float> usage-fraction: -1;
    in property <string> usage-short: "-";
    in property <string> usage-label;
    in property <string> usage-reset;
    // The weekly limit; its gauge shows only when the share is known.
    in property <float> weekly-fraction: -1;
    in property <string> weekly-short;
    in property <string> weekly-reset;
    // Tokens and burn rate from local logs, when there are any.
    in property <string> usage-detail;
    in property <Health> status;
    in property <bool> usage-estimated;
    private property <color> accent: self.usage-provider == Provider.chatgpt ? Theme.chatgpt
        : self.usage-provider == Provider.gemini ? Theme.gemini : Theme.claude;
    // The provider's colour, turning amber and then red as a limit runs out.
    pure function level(fraction: float) -> color {
        return fraction >= 0.95 ? Theme.bad : fraction >= 0.8 ? Theme.warn : self.accent;
    }
    private property <string> provider-name: self.usage-provider == Provider.chatgpt ? "ChatGPT"
        : self.usage-provider == Provider.gemini ? "Gemini" : "Claude";

    // The permission request on screen, if any. Rust keeps the queue.
    in property <bool> has-request;
    in property <int> request-id;
    in property <string> request-tool;
    in property <string> request-project;
    in property <string> request-detail;
    in property <int> request-more;
    callback decide(int, Choice);

    // A short attention message; Rust sets and clears it.
    in property <bool> alert-active;
    in property <AlertKind> alert-kind;
    in property <string> alert-text;
    callback alert-clicked();

    // The size the shape is heading to. Rust clips the window to it, growing the region
    // at once and shrinking it after the animation, so clicks elsewhere pass through.
    out property <length> shape-width: self.target-width;
    out property <length> shape-height: self.target-height;
    callback shape-changed();
    changed shape-width => {
        self.shape-changed();
    }
    changed shape-height => {
        self.shape-changed();
    }

    // Right-click on the notch; Rust shows a native menu because a Slint popup would be
    // clipped by the window region.
    callback menu-requested();

    // Dragging the notch with the left button: press, each move, and release. Rust moves
    // the window along the top edge by how far the cursor travelled on screen, since the
    // pill itself resizes during a drag.
    callback drag-started();
    callback dragged();
    callback drag-ended();

    // Opens after a short hover and closes after a short absence, so grazing the edge or
    // passing over it does not make the shape flicker.
    private property <bool> expanded;
    Timer {
        interval: 120ms;
        running: hover.has-hover && !root.expanded;
        triggered => {
            root.expanded = true;
        }
    }
    Timer {
        interval: 250ms;
        running: !hover.has-hover && root.expanded;
        triggered => {
            root.expanded = false;
        }
    }

    private property <length> target-width: self.has-request ? request-width
        : self.alert-active ? alert-width
        : self.expanded ? open-width : idle-width;
    private property <length> target-height: self.has-request ? request-height
        : self.alert-active ? alert-height
        : self.expanded ? open-height : idle-height;
    private property <length> idle-width: 250px;
    private property <length> idle-height: 30px;
    private property <length> open-width: 460px;
    private property <length> open-height: 106px;
    private property <length> request-width: 460px;
    private property <length> request-height: 196px;
    private property <length> alert-width: 290px;
    private property <length> alert-height: 34px;

    title: "ai-notch";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // Fixed size large enough for the biggest state; only the shape is drawn.
    // Exposed because Rust positions the window before Slint knows its size.
    out property <length> fixed-width: 520px;
    width: self.fixed-width;
    height: 280px;

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: root.idle-width;
        height: root.idle-height;
        background: Theme.surface;
        border-bottom-left-radius: min(self.height / 2, 22px);
        border-bottom-right-radius: self.border-bottom-left-radius;
        clip: true;

        hover := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            moved => {
                root.dragged();
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.menu-requested();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-started();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.drag-ended();
                }
            }
        }

        idle-row := HorizontalLayout {
            alignment: center;
            spacing: 18px;
            Pair {
                label: "CPU";
                value: "\{round(root.cpu * 100)}%";
            }
            Pair {
                label: "GPU";
                value: "\{round(root.gpu * 100)}%";
            }
            HorizontalLayout {
                spacing: 6px;
                Ring {
                    y: (parent.height - self.height) / 2;
                    fraction: root.usage-fraction;
                    fill: root.level(root.usage-fraction);
                }
                Text {
                    text: root.usage-short;
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        detail := VerticalLayout {
            opacity: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 18px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 18px;
                Stat {
                    label: "CPU";
                    value: "\{round(root.cpu * 100)}%";
                    fraction: root.cpu;
                }
                Stat {
                    label: "GPU";
                    value: "\{round(root.gpu * 100)}%";
                    fraction: root.gpu;
                }
                Stat {
                    label: "RAM";
                    value: root.ram-text;
                    fraction: root.ram;
                }
                Stat {
                    label: "VRAM";
                    value: root.vram-text;
                    fraction: root.vram;
                }
            }

            HorizontalLayout {
                spacing: 18px;

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        Dot {
                            fill: root.accent;
                        }
                        Text {
                            text: root.provider-name;
                            color: Theme.text;
                            font-family: Theme.font;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        // Only incidents show; a healthy or unknown status takes no space.
                        if root.status == Health.degraded || root.status == Health.down: Text {
                            text: root.status == Health.down ? "· Outage" : "· Degraded";
                            color: root.status == Health.down ? Theme.bad : Theme.warn;
                            font-family: Theme.font;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if root.usage-estimated: Badge {
                            label: "ESTIMATED";
                        }
                    }
                    if root.usage-detail != "": Text {
                        text: root.usage-detail;
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: 10px;
                    }
                }

                Gauge {
                    fraction: root.usage-fraction;
                    fill: root.level(root.usage-fraction);
                    value: root.usage-short;
                    label: root.usage-label;
                    detail: root.usage-reset;
                }
                if root.weekly-fraction >= 0: Gauge {
                    fraction: root.weekly-fraction;
                    fill: root.level(root.weekly-fraction);
                    value: root.weekly-short;
                    label: "week";
                    detail: root.weekly-reset;
                }
            }
        }

        request-view := VerticalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 12px;
            padding-bottom: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 6px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.claude;
                    }
                }
                Text {
                    text: "Claude wants to use \{root.request-tool}";
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.request-more > 0
                        ? "\{root.request-project}  +\{root.request-more}"
                        : root.request-project;
                    color: Theme.muted;
                    font-family: Theme.font;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 104px;
                background: #161618;
                border-radius: 10px;
                clip: true;

                Flickable {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    content-height: max(self.height, command.preferred-height);

                    command := Text {
                        width: parent.width;
                        height: self.preferred-height;
                        vertical-alignment: top;
                        text: root.request-detail;
                        color: #e5e5ea;
                        font-family: "Cascadia Mono";
                        font-size: 11px;
                        wrap: char-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                LinkButton {
                    label: "Open in app";
                    clicked => {
                        root.decide(root.request-id, Choice.ask-in-app);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                PillButton {
                    label: "Deny";
                    clicked => {
                        root.decide(root.request-id, Choice.deny);
                    }
                }
                PillButton {
                    label: "Allow";
                    primary: true;
                    clicked => {
                        root.decide(root.request-id, Choice.allow);
                    }
                }
            }
        }

        alert-view := HorizontalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            alignment: center;
            spacing: 9px;
            padding-left: 18px;
            padding-right: 18px;

            Rectangle {
                width: 8px;
                // Only exists while an alert shows, so the pulse never runs in the background.
                if root.alert-active: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.alert-kind == AlertKind.done ? Theme.good
                        : root.alert-kind == AlertKind.usage-high ? Theme.warn
                        : root.alert-kind == AlertKind.usage-critical ? Theme.bad
                        : Theme.claude;
                    opacity: 0.55 + 0.45 * Math.sin(animation-tick() / 1100ms * 360deg);
                }
            }
            Text {
                text: root.alert-text;
                color: Theme.text;
                font-family: Theme.font;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Above the hover area, so a click on an alert focuses its session.
        TouchArea {
            enabled: root.alert-active && !root.has-request;
            clicked => {
                root.alert-clicked();
            }
        }

        states [
            request when root.has-request: {
                pill.width: root.request-width;
                pill.height: root.request-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                request-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate request-view.opacity { duration: 140ms; delay: 160ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate request-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            alert when root.alert-active: {
                pill.width: root.alert-width;
                pill.height: root.alert-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                alert-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate alert-view.opacity { duration: 140ms; delay: 140ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate alert-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            open when root.expanded: {
                pill.width: root.open-width;
                pill.height: root.open-height;
                idle-row.opacity: 0;
                detail.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; delay: 80ms; }
                    animate idle-row.opacity { duration: 80ms; }
                    animate detail.opacity { duration: 140ms; delay: 180ms; }
                }
                out {
                    animate pill.width, pill.height { duration: 200ms; easing: ease-out; }
                    animate detail.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
        ]
    }
}
