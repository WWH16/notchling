// Notch UI: one near-black shape that flows out of a screen edge and morphs between
// states. Its mark is the provider's logo inside the ring of the provider's limit.

export { Settings } from "settings.slint";

export global Theme {
    // Near-black, tinted a touch cool, so the shape reads as a cut-out of the screen.
    out property <color> surface: #0b0b0d;
    out property <color> text: #f5f5f7;
    out property <color> muted: #8e8e93;
    out property <color> track: #2c2c2e;
    // The hairline between the panel's usage and its system readings.
    out property <color> rule: #1f1f22;
    // Borders, and an outline button while pressed.
    out property <color> outline: #3a3a3c;
    // The command box on a request card.
    out property <color> code-surface: #161618;
    out property <color> code-text: #e5e5ea;
    // The primary button, light on the dark notch, with its hover and pressed shades.
    out property <color> button: #ececee;
    out property <color> button-hover: #f5f5f7;
    out property <color> button-pressed: #d1d1d6;
    out property <color> claude: #d97757;
    out property <color> chatgpt: #10a37f;
    out property <color> gemini: #4c8df6;
    out property <color> good: #30d158;
    out property <color> warn: #ff9f0a;
    out property <color> bad: #ff453a;
    // A limit's colour: green while there is room, amber from 80% used, red from 95%,
    // where the usage alerts fire by default.
    public pure function level(fraction: float) -> color {
        return fraction >= 0.95 ? self.bad : fraction >= 0.8 ? self.warn : self.good;
    }
    // Segoe UI digits are tabular by default, so numbers don't jitter.
    out property <string> font: "Segoe UI Variable";
    // Cascadia Mono where it is installed, else Consolas, which every Windows has; Rust
    // picks one.
    in property <string> mono: "Consolas";
    // Windows' text size, 1 at 100%. Text and the shapes holding it grow with it.
    in property <float> text-scale: 1;
    // Type sizes; nothing is smaller than 10px, which stays legible at 100% scaling.
    out property <length> size-small: 10px * self.text-scale;
    out property <length> size-label: 11px * self.text-scale;
    out property <length> size-value: 12px * self.text-scale;
    out property <length> size-large: 13px * self.text-scale;
    // Windows "Show animations" is off: shapes change at once and only fades remain.
    in property <bool> reduce-motion;
}

// What the user picked on a permission request.
export enum Choice { allow, deny, ask-in-app }

// Whose usage the notch shows.
export enum Provider { claude, chatgpt, gemini }

// The shown provider's status page; unknown until checked or when the check fails.
export enum Health { unknown, operational, degraded, down }

// The screen edge the notch sticks to; Rust picks the nearest one when it is dropped.
export enum NotchEdge { top, bottom, left, right }

// Why the notch is asking for attention.
export enum AlertKind { done, needs-input, usage-high, usage-critical }

// One limit as the hover panel shows it; Rust formats the texts. `used` is a fraction
// in 0..1, or below 0 when unknown.
export struct LimitView {
    name: string,
    used: float,
    // "Resets at 10:59 PM", "Resets Fri 6:59 AM" or "Resets Nov 3".
    reset: string,
    // "23% used" and "77% left", or an empty used text and why the share is missing.
    used-text: string,
    left-text: string,
}

// A line of the hover panel's limits: a model group's title, or up to two limits side
// by side. A lone limit on a wide line keeps half the width, so columns stay aligned.
export struct LimitLine {
    title: string,
    left: LimitView,
    right: LimitView,
    paired: bool,
    half: bool,
}

component Label inherits Text {
    color: Theme.muted;
    font-family: Theme.font;
    font-size: Theme.size-label;
    vertical-alignment: center;
}

component Value inherits Text {
    color: Theme.text;
    font-family: Theme.font;
    font-size: Theme.size-value;
    font-weight: 600;
    vertical-alignment: center;
}

// A provider's mark, centred in whatever height a layout gives it. The paths are the
// publishers' own, unchanged: Claude and Gemini from Simple Icons 16.36.0 (CC0), OpenAI
// from LobeHub Icons 1.101.0 (MIT), since Simple Icons no longer carries it.
component Logo inherits Rectangle {
    in property <Provider> provider;
    in property <color> fill;
    in property <length> size: 14px * Theme.text-scale;
    width: self.size;
    min-height: self.size;

    if root.provider == Provider.claude: Path {
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.fill;
        commands: "m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z";
    }
    if root.provider == Provider.chatgpt: Path {
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.fill;
        fill-rule: evenodd;
        commands: "M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z";
    }
    if root.provider == Provider.gemini: Path {
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.fill;
        commands: "M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81";
    }
}

// A thin circular progress ring; an empty track when the share is unknown (below 0).
component Ring inherits Rectangle {
    in property <float> fraction;
    in property <color> fill;
    in property <length> thickness: 2px;
    width: 14px * Theme.text-scale;
    height: self.width;

    Rectangle {
        border-radius: self.width / 2;
        border-width: root.thickness;
        border-color: Theme.track;
    }

    // In viewbox units: the radius that centres the stroke on the track.
    property <float> radius: (root.width - root.thickness) / root.width * 50;
    // A full turn would start and end at the same point and draw nothing.
    property <angle> sweep-angle: min(root.fraction, 0.999) * 360deg;
    if root.fraction > 0.005: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.fill;
        stroke-width: root.thickness;

        MoveTo {
            x: 50;
            y: 50 - root.radius;
        }
        ArcTo {
            x: 50 + root.radius * sin(root.sweep-angle);
            y: 50 - root.radius * cos(root.sweep-angle);
            radius-x: root.radius;
            radius-y: root.radius;
            large-arc: root.fraction > 0.5;
            sweep: true;
        }
    }
}

// The notch's signature: the provider's mark inside the ring of its main limit, centred
// in whatever height a layout gives it.
component MarkRing inherits Rectangle {
    in property <Provider> provider;
    in property <float> fraction;
    // The ring's colour, which turns amber and then red as the limit runs out.
    in property <color> level;
    in property <color> mark;
    in property <length> size: 22px * Theme.text-scale;
    width: self.size;
    min-height: self.size;

    Ring {
        y: (parent.height - self.height) / 2;
        width: root.size;
        fraction: root.fraction;
        fill: root.level;
        thickness: 2px;
    }
    Logo {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        height: self.size;
        size: root.size * 0.55;
        provider: root.provider;
        fill: root.mark;
    }
}

component Bar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill: Theme.text;
    height: 2px;
    border-radius: self.height / 2;
    background: Theme.track;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.fraction, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: Theme.reduce-motion ? 0ms : 300ms; easing: ease-out; }
    }
}

// A system reading: its name and value over a thin bar.
component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> fraction;
    spacing: 6px;

    HorizontalLayout {
        spacing: 6px;
        Label {
            text: root.label;
        }
        Value {
            text: root.value;
            horizontal-alignment: right;
        }
    }
    Bar {
        fraction: root.fraction;
    }
}

// A label over its value, for the upright notch on a side edge.
component StackedPair inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 1px;

    Label {
        text: root.label;
        horizontal-alignment: center;
    }
    Value {
        text: root.value;
        horizontal-alignment: center;
    }
}

// One limit: its name and share used over a bar in the colour of that share, then when
// it resets and what is left. The name gets the full first line, so it rarely elides.
component LimitBar inherits VerticalLayout {
    in property <LimitView> limit;
    spacing: 6px;
    accessible-role: progress-indicator;
    accessible-label: self.limit.name;
    accessible-value: self.limit.used-text;
    accessible-description: "\{self.limit.left-text}. \{self.limit.reset}";

    HorizontalLayout {
        spacing: 10px;
        Value {
            text: root.limit.name;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Value {
            text: root.limit.used-text;
            horizontal-alignment: right;
        }
    }
    Bar {
        height: 4px;
        fraction: max(root.limit.used, 0);
        fill: Theme.level(root.limit.used);
    }
    HorizontalLayout {
        spacing: 10px;
        Label {
            text: root.limit.reset;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Label {
            text: root.limit.left-text;
            horizontal-alignment: right;
        }
    }
}

// A line of limits: a model group's title, or one or two limits side by side.
component LimitRow inherits VerticalLayout {
    in property <LimitLine> line;

    if root.line.title != "": Value {
        // More room above a group's title than below it.
        height: self.preferred-height + 6px;
        vertical-alignment: bottom;
        text: root.line.title;
        font-size: Theme.size-large;
    }
    if root.line.title == "": HorizontalLayout {
        spacing: 24px;
        LimitBar {
            limit: root.line.left;
            horizontal-stretch: 1;
        }
        if root.line.paired: LimitBar {
            limit: root.line.right;
            horizontal-stretch: 1;
        }
        if root.line.half: Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// The provider's mark and name, any incident on its status page, and whether its
// numbers are an estimate.
component ProviderName inherits HorizontalLayout {
    in property <Provider> provider;
    in property <color> accent;
    in property <string> name;
    in property <Health> status;
    in property <bool> estimated;
    alignment: start;
    spacing: 8px;

    Logo {
        provider: root.provider;
        fill: root.accent;
        size: 15px * Theme.text-scale;
    }
    Value {
        text: root.name;
        font-size: Theme.size-large;
    }
    // Only incidents show; a healthy or unknown status takes no space.
    if root.status == Health.degraded || root.status == Health.down: Value {
        text: root.status == Health.down ? "Outage" : "Degraded";
        color: root.status == Health.down ? Theme.bad : Theme.warn;
        font-size: Theme.size-label;
    }
    if root.estimated: Label {
        text: "estimated";
    }
}

// A concave fillet joining the notch to its screen edge: a square with a quarter circle
// cut away. The circle's centre sits at the corner `cx`, `cy` (0 or 1: left or right, top
// or bottom), the corner away from both the edge and the notch.
component Shoulder inherits Path {
    in property <int> cx;
    in property <int> cy;
    fill: Theme.surface;
    viewbox-width: 100;
    viewbox-height: 100;

    MoveTo {
        x: root.cx * 100;
        y: (1 - root.cy) * 100;
    }
    LineTo {
        x: (1 - root.cx) * 100;
        y: (1 - root.cy) * 100;
    }
    LineTo {
        x: (1 - root.cx) * 100;
        y: root.cy * 100;
    }
    ArcTo {
        x: root.cx * 100;
        y: (1 - root.cy) * 100;
        radius-x: 100;
        radius-y: 100;
        sweep: root.cx == root.cy;
    }
    Close { }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    // Until armed the button ignores clicks and fills up as `progress` runs from 0 to 1.
    in property <bool> armed: true;
    in property <float> progress: 1;
    callback clicked();
    width: max(68px * Theme.text-scale, label-text.preferred-width + 28px);
    height: 28px * Theme.text-scale;
    border-radius: self.height / 2;
    border-width: self.primary ? 0 : 1px;
    border-color: Theme.outline;
    clip: true;
    background: !self.armed ? (self.primary ? Theme.outline : transparent)
        : self.primary
        ? (touch.pressed ? Theme.button-pressed : touch.has-hover ? Theme.button-hover : Theme.button)
        : (touch.pressed ? Theme.outline : touch.has-hover ? Theme.track : transparent);
    accessible-role: button;
    accessible-label: self.label;
    accessible-enabled: self.armed;
    accessible-action-default => {
        root.clicked();
    }

    if !root.armed: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        background: root.primary ? Theme.muted : Theme.track;
    }

    label-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary && root.armed ? Theme.surface : Theme.text;
        font-family: Theme.font;
        font-size: Theme.size-value;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.armed;
        clicked => {
            root.clicked();
        }
    }
}

component LinkButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: link-text.preferred-width;
    height: 28px * Theme.text-scale;
    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => {
        root.clicked();
    }

    link-text := Text {
        height: parent.height;
        text: root.label;
        color: touch.has-hover ? Theme.text : Theme.muted;
        font-family: Theme.font;
        font-size: Theme.size-label;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Notch inherits Window {
    // Loads as fractions in 0..1; text values are formatted by Rust.
    in property <float> cpu;
    in property <float> gpu;
    in property <float> ram;
    in property <float> vram;
    in property <string> ram-text: "-";
    in property <string> vram-text: "-";

    // AI usage of the selected provider; texts are formatted by Rust. Shares are
    // fractions in 0..1, or below 0 when unknown.
    in property <Provider> usage-provider;
    // The limit the pill follows.
    in property <float> usage-fraction: -1;
    in property <string> usage-short: "-";
    // Every limit the provider reported, laid out two to a line for the wide panel and
    // one to a line for the upright one, with each model group's title on its own line.
    in property <[LimitLine]> wide-lines;
    in property <[LimitLine]> tall-lines;
    // Tokens and burn rate from local logs, e.g. "1.2M tokens" and "3.4k/min"; empty
    // when there are none.
    in property <string> usage-tokens;
    in property <string> usage-rate;
    // "via Antigravity" when a provider has more than one source; empty otherwise.
    in property <string> usage-via;
    in property <Health> status;
    in property <bool> usage-estimated;
    // How long the longest-working Claude session has been at it, e.g. "3m", and how many
    // sessions are working; empty and 0 while Claude rests.
    in property <string> activity;
    in property <int> activity-sessions;
    // The provider's colour, for its logo.
    private property <color> accent: self.usage-provider == Provider.chatgpt ? Theme.chatgpt
        : self.usage-provider == Provider.gemini ? Theme.gemini : Theme.claude;
    private property <string> provider-name: self.usage-provider == Provider.chatgpt ? "ChatGPT"
        : self.usage-provider == Provider.gemini ? "Gemini" : "Claude";

    // The permission request on screen, if any. Rust keeps the queue.
    in property <bool> has-request;
    in property <int> request-id;
    in property <string> request-tool;
    in property <string> request-project;
    in property <string> request-detail;
    in property <int> request-more;
    // Whether Ctrl+Alt+Y and Ctrl+Alt+N answer the request; Rust claims the keys.
    in property <bool> shortcuts;
    callback decide(int, Choice);
    // Runs when a request card appears or goes, so Rust can claim or release the keys.
    callback request-shown-changed();
    changed has-request => {
        if self.has-request {
            self.arm();
        }
        self.request-shown-changed();
    }
    changed request-id => {
        self.arm();
    }

    // Allow and Deny ignore clicks for a moment after a card appears, so a click meant
    // for the window behind the notch cannot answer a request nobody has read.
    out property <bool> request-armed;
    private property <duration> arm-delay: 500ms;
    private property <duration> armed-from;
    private property <float> arming: self.request-armed ? 1
        : clamp((animation-tick() - self.armed-from) / self.arm-delay, 0, 1);
    function arm() {
        self.request-armed = false;
        self.armed-from = animation-tick();
        arm-timer.stop();
        arm-timer.start();
    }
    arm-timer := Timer {
        interval: root.arm-delay;
        running: false;
        triggered => {
            root.request-armed = true;
            self.stop();
        }
    }

    // Answers the request on the card, once it is armed; the buttons and shortcuts
    // both come through here.
    public function answer(choice: Choice) {
        if self.has-request && self.request-armed {
            self.decide(self.request-id, choice);
        }
    }

    // A short attention message; Rust sets and clears it. Its mark is the provider it
    // is about: Claude for a session, the provider for a usage alert.
    in property <bool> alert-active;
    in property <AlertKind> alert-kind;
    in property <Provider> alert-provider;
    in property <string> alert-text;
    callback alert-clicked();
    private property <color> alert-mark: self.alert-kind == AlertKind.usage-critical ? Theme.bad
        : self.alert-kind == AlertKind.usage-high ? Theme.warn
        : self.alert-provider == Provider.chatgpt ? Theme.chatgpt
        : self.alert-provider == Provider.gemini ? Theme.gemini : Theme.claude;

    // The size the shape is heading to, shoulders included. Rust clips the window to it,
    // growing the region at once and shrinking it after the animation, so clicks
    // elsewhere pass through.
    out property <length> shape-width: self.target-width + (self.vertical ? 0 : 2 * self.target-shoulder);
    out property <length> shape-height: self.target-height + (self.vertical ? 2 * self.target-shoulder : 0);
    // The size the shape has right now, partway through a morph.
    out property <length> drawn-width: pill.width + (self.vertical ? 0 : 2 * self.shoulder);
    out property <length> drawn-height: pill.height + (self.vertical ? 2 * self.shoulder : 0);
    callback shape-changed();
    changed shape-width => {
        self.shape-changed();
    }
    changed shape-height => {
        self.shape-changed();
    }

    // Right-click on the notch; Rust shows a native menu because a Slint popup would be
    // clipped by the window region.
    callback menu-requested();

    // Dragging the notch with the left button: press, each move, and release. Rust moves
    // the window by how far the cursor travelled on screen, since the pill itself resizes
    // during a drag, and sticks it to an edge it is dropped near.
    in property <NotchEdge> edge;
    // While it is dragged, the notch is a free pill with every corner round.
    in property <bool> floating;
    // On a side edge, the idle notch tucks into a thin sliver until the pointer reaches it.
    in property <bool> tuck;
    callback drag-started();
    callback dragged();
    callback drag-ended();

    // Opens the moment the pointer arrives and closes after a short absence, so slipping
    // off the edge for an instant does not shut it. A click keeps it open until the next
    // click, which closes it until the pointer leaves.
    private property <bool> expanded;
    private property <bool> pinned;
    private property <bool> dismissed;
    private property <bool> hovered: hover.has-hover;
    changed hovered => {
        if !self.hovered {
            self.dismissed = false;
        } else if !self.dismissed {
            self.expanded = true;
        }
    }
    Timer {
        interval: 250ms;
        running: !root.hovered && root.expanded && !root.pinned;
        triggered => {
            root.expanded = false;
        }
    }
    // Hovering opens the panel first, so a click pins it, and a click on a pinned panel
    // closes it.
    function toggle-panel() {
        if self.pinned {
            self.expanded = false;
            self.pinned = false;
            self.dismissed = true;
        } else {
            self.expanded = true;
            self.pinned = true;
        }
    }

    private property <length> target-width: self.has-request ? request-width
        : self.alert-active ? alert-width
        : self.expanded ? open-width : idle-width;
    private property <length> target-height: self.has-request ? request-height
        : self.alert-active ? alert-height
        : self.expanded ? open-height : idle-height;
    // On a side edge the notch stands upright; requests and alerts stay wide, since their
    // text needs the room.
    private property <bool> vertical: self.edge == NotchEdge.left || self.edge == NotchEdge.right;
    private property <bool> tucked: self.tuck && self.vertical && !self.hovered && !self.expanded
        && !self.has-request && !self.alert-active && !self.floating;
    private property <bool> working: self.activity != "";
    private property <length> idle-width: self.tucked ? 6px
        : (self.vertical ? 56px : self.working ? 312px : 236px) * Theme.text-scale;
    private property <length> idle-height: self.tucked ? 96px
        : (self.vertical ? (self.working ? 196px : 148px) : 32px) * Theme.text-scale;
    // Wide enough for "ChatGPT", "Outage" and "estimated" on one line, and as tall as
    // the provider's limits need, within the window less its shoulders.
    private property <length> open-width: (self.vertical ? 230px : 460px) * Theme.text-scale;
    private property <length> open-height: min(panel.preferred-height,
        self.fixed-height - 2 * self.shoulder-radius);
    // The idle and open sizes as drawn, easing into the other orientation when the notch
    // moves between a side edge and the top or bottom. The window region follows the
    // targets above instead, since re-clipping on every frame made the notch flicker.
    private property <length> drawn-idle-width: self.idle-width;
    private property <length> drawn-idle-height: self.idle-height;
    private property <length> drawn-open-width: self.open-width;
    private property <length> drawn-open-height: self.open-height;
    animate drawn-idle-width, drawn-idle-height, drawn-open-width, drawn-open-height {
        duration: Theme.reduce-motion ? 0ms : 260ms;
        easing: ease-out;
    }
    private property <length> request-width: 460px * Theme.text-scale;
    private property <length> request-height: 196px * Theme.text-scale;
    private property <length> alert-width: 290px * Theme.text-scale;
    private property <length> alert-height: 36px * Theme.text-scale;

    // The shoulders: concave curves where the notch flows out of its edge. They fold away
    // with the edge corners while the notch is dragged, and the region allows for the
    // target reach, not the animation.
    private property <length> shoulder-radius: 14px * Theme.text-scale;
    private property <float> edge-round: self.edge == NotchEdge.top ? pill.round-top
        : self.edge == NotchEdge.bottom ? pill.round-bottom
        : self.edge == NotchEdge.left ? pill.round-left : pill.round-right;
    private property <length> shoulder: self.shoulder-radius * (1 - self.edge-round);
    private property <length> target-shoulder: self.floating ? 0 : self.shoulder-radius;
    // Each shoulder tucks this far under the body, so no seam shows between them.
    private property <length> shoulder-overlap: 1px;

    title: "ai-notch";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // Fixed size large enough for the biggest state and its shoulders; only the shape is
    // drawn. Exposed because Rust positions the window before Slint knows its size.
    out property <length> fixed-width: 520px * Theme.text-scale;
    out property <length> fixed-height: 600px * Theme.text-scale;
    // Runs when the text size changes the window's size, so Rust can place it again.
    callback size-changed();
    changed fixed-width => {
        self.size-changed();
    }
    width: self.fixed-width;
    height: self.fixed-height;

    // Before the body, so the body covers their overlap.
    if root.shoulder > 0.5px: Shoulder {
        width: root.shoulder;
        height: root.shoulder;
        x: root.edge == NotchEdge.left ? 0
            : root.edge == NotchEdge.right ? parent.width - self.width
            : pill.x - self.width + root.shoulder-overlap;
        y: root.edge == NotchEdge.top ? 0
            : root.edge == NotchEdge.bottom ? parent.height - self.height
            : pill.y - self.height + root.shoulder-overlap;
        cx: root.edge == NotchEdge.left ? 1 : 0;
        cy: root.edge == NotchEdge.top ? 1 : 0;
    }
    if root.shoulder > 0.5px: Shoulder {
        width: root.shoulder;
        height: root.shoulder;
        x: root.edge == NotchEdge.left ? 0
            : root.edge == NotchEdge.right ? parent.width - self.width
            : pill.x + pill.width - root.shoulder-overlap;
        y: root.edge == NotchEdge.top ? 0
            : root.edge == NotchEdge.bottom ? parent.height - self.height
            : pill.y + pill.height - root.shoulder-overlap;
        cx: root.edge == NotchEdge.right ? 0 : 1;
        cy: root.edge == NotchEdge.bottom ? 0 : 1;
    }

    pill := Rectangle {
        // Against the window side that faces the screen edge, centered the other way, so
        // the notch always grows away from the edge.
        x: root.edge == NotchEdge.left ? 0
            : root.edge == NotchEdge.right ? parent.width - self.width
            : (parent.width - self.width) / 2;
        y: root.edge == NotchEdge.top ? 0
            : root.edge == NotchEdge.bottom ? parent.height - self.height
            : (parent.height - self.height) / 2;
        width: root.drawn-idle-width;
        height: root.drawn-idle-height;
        background: Theme.surface;
        // The side against the screen edge stays square, where the shoulders join it;
        // every other corner is round. Each side's roundness runs from 0 (square) to 1
        // (round), easing between the two as the notch is picked up and sticks again.
        property <length> corner: min(min(self.width, self.height) / 2, 22px);
        property <float> round-top: !root.floating && root.edge == NotchEdge.top ? 0 : 1;
        property <float> round-bottom: !root.floating && root.edge == NotchEdge.bottom ? 0 : 1;
        property <float> round-left: !root.floating && root.edge == NotchEdge.left ? 0 : 1;
        property <float> round-right: !root.floating && root.edge == NotchEdge.right ? 0 : 1;
        animate round-top, round-bottom, round-left, round-right {
            duration: Theme.reduce-motion ? 0ms : 260ms;
            easing: ease-out;
        }
        border-top-left-radius: self.corner * min(self.round-top, self.round-left);
        border-top-right-radius: self.corner * min(self.round-top, self.round-right);
        border-bottom-left-radius: self.corner * min(self.round-bottom, self.round-left);
        border-bottom-right-radius: self.corner * min(self.round-bottom, self.round-right);
        clip: true;
        accessible-role: groupbox;
        accessible-label: "ai-notch";
        accessible-description: "\{root.provider-name} \{root.usage-short}, CPU \{round(root.cpu * 100)}%, GPU \{round(root.gpu * 100)}%"
            + (root.working ? ", Claude working \{root.activity}" : "");

        hover := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            moved => {
                root.dragged();
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.menu-requested();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-started();
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    // Rust sets `floating` once the pointer moves far enough to drag, so
                    // a release without it is a click.
                    if !root.floating && !root.has-request && !root.alert-active {
                        root.toggle-panel();
                    }
                    root.drag-ended();
                }
            }
        }

        // The tucked sliver's mark, in the colour of the usage ring.
        if root.tucked: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 24px;
            border-radius: 1px;
            background: root.usage-fraction >= 0 ? Theme.level(root.usage-fraction) : Theme.muted;
        }

        idle-row := Rectangle {
            // The provider leads; the system readings follow, quieter.
            if !root.vertical: HorizontalLayout {
                alignment: center;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 7px;
                    MarkRing {
                        provider: root.usage-provider;
                        fraction: root.usage-fraction;
                        level: Theme.level(root.usage-fraction);
                        mark: root.accent;
                    }
                    Value {
                        text: root.usage-short;
                    }
                }
                HorizontalLayout {
                    spacing: 5px;
                    Label {
                        text: "CPU";
                    }
                    Value {
                        text: "\{round(root.cpu * 100)}%";
                    }
                }
                HorizontalLayout {
                    spacing: 5px;
                    Label {
                        text: "GPU";
                    }
                    Value {
                        text: "\{round(root.gpu * 100)}%";
                    }
                }
                if root.working: HorizontalLayout {
                    spacing: 5px;
                    Logo {
                        provider: Provider.claude;
                        fill: Theme.claude;
                        size: 11px * Theme.text-scale;
                    }
                    Value {
                        text: root.activity;
                    }
                    if root.activity-sessions > 1: Label {
                        text: "×\{root.activity-sessions}";
                    }
                }
            }
            if root.vertical: VerticalLayout {
                alignment: center;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        MarkRing {
                            size: 26px * Theme.text-scale;
                            provider: root.usage-provider;
                            fraction: root.usage-fraction;
                            level: Theme.level(root.usage-fraction);
                            mark: root.accent;
                        }
                    }
                    Value {
                        text: root.usage-short;
                        horizontal-alignment: center;
                    }
                }
                StackedPair {
                    label: "CPU";
                    value: "\{round(root.cpu * 100)}%";
                }
                StackedPair {
                    label: "GPU";
                    value: "\{round(root.gpu * 100)}%";
                }
                if root.working: VerticalLayout {
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: center;
                        Logo {
                            provider: Provider.claude;
                            fill: Theme.claude;
                            size: 11px * Theme.text-scale;
                        }
                    }
                    Value {
                        text: root.activity;
                        font-size: Theme.size-label;
                        horizontal-alignment: center;
                    }
                    if root.activity-sessions > 1: Label {
                        text: "×\{root.activity-sessions}";
                        horizontal-alignment: center;
                    }
                }
            }
        }

        detail := Rectangle {
            opacity: 0;

            // The provider and its limits first, then the system readings under a hairline.
            // Its height sets the open panel's, so each provider gets the room it needs.
            panel := VerticalLayout {
                alignment: start;
                padding-left: root.vertical ? 18px : 20px;
                padding-right: root.vertical ? 18px : 20px;
                padding-top: 16px;
                padding-bottom: 18px;
                spacing: root.vertical ? 12px : 14px;

                HorizontalLayout {
                    spacing: 12px;
                    ProviderName {
                        provider: root.usage-provider;
                        accent: root.accent;
                        name: root.provider-name;
                        status: root.status;
                        estimated: root.usage-estimated;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if !root.vertical && root.usage-tokens != "": Label {
                        text: root.usage-tokens;
                    }
                    if !root.vertical && root.usage-rate != "": Label {
                        text: root.usage-rate;
                    }
                    if !root.vertical && root.usage-via != "": Label {
                        text: root.usage-via;
                    }
                }
                if root.vertical && (root.usage-tokens != "" || root.usage-rate != "" || root.usage-via != ""): HorizontalLayout {
                    alignment: start;
                    spacing: 12px;
                    if root.usage-tokens != "": Label {
                        text: root.usage-tokens;
                    }
                    if root.usage-rate != "": Label {
                        text: root.usage-rate;
                    }
                    if root.usage-via != "": Label {
                        text: root.usage-via;
                    }
                }

                for limit-line in root.vertical ? root.tall-lines : root.wide-lines: LimitRow {
                    line: limit-line;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.rule;
                }

                if !root.vertical: HorizontalLayout {
                    spacing: 18px;
                    Stat {
                        label: "CPU";
                        value: "\{round(root.cpu * 100)}%";
                        fraction: root.cpu;
                    }
                    Stat {
                        label: "GPU";
                        value: "\{round(root.gpu * 100)}%";
                        fraction: root.gpu;
                    }
                    Stat {
                        label: "RAM";
                        value: root.ram-text;
                        fraction: root.ram;
                    }
                    Stat {
                        label: "VRAM";
                        value: root.vram-text;
                        fraction: root.vram;
                    }
                }
                // Upright, the readings pair up so the panel stays short.
                if root.vertical: HorizontalLayout {
                    spacing: 16px;
                    Stat {
                        label: "CPU";
                        value: "\{round(root.cpu * 100)}%";
                        fraction: root.cpu;
                    }
                    Stat {
                        label: "GPU";
                        value: "\{round(root.gpu * 100)}%";
                        fraction: root.gpu;
                    }
                }
                if root.vertical: HorizontalLayout {
                    spacing: 16px;
                    Stat {
                        label: "RAM";
                        value: root.ram-text;
                        fraction: root.ram;
                    }
                    Stat {
                        label: "VRAM";
                        value: root.vram-text;
                        fraction: root.vram;
                    }
                }
            }
        }

        request-view := VerticalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 13px;
            padding-bottom: 14px;
            spacing: 10px;
            accessible-role: groupbox;
            accessible-label: "Claude wants to use \{root.request-tool}";
            accessible-description: root.request-detail;

            HorizontalLayout {
                spacing: 8px;
                Logo {
                    provider: Provider.claude;
                    fill: Theme.claude;
                }
                Value {
                    text: "Claude wants to use \{root.request-tool}";
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Label {
                    text: root.request-project;
                }
                if root.request-more > 0: Label {
                    text: "\{root.request-more} more";
                    color: Theme.text;
                }
            }

            code-box := Rectangle {
                height: 104px * Theme.text-scale;
                background: Theme.code-surface;
                border-radius: 10px;
                clip: true;

                code := Flickable {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    content-height: max(self.height, command.preferred-height);

                    command := Text {
                        // Slint centres a shorter child; a short command starts at the top.
                        y: 0;
                        width: parent.width;
                        height: self.preferred-height;
                        vertical-alignment: top;
                        text: root.request-detail;
                        color: Theme.code-text;
                        font-family: Theme.mono;
                        font-size: Theme.size-label;
                        wrap: char-wrap;
                    }
                }

                // One line of the command's font, to count the lines scrolled out of view.
                line := Text {
                    visible: false;
                    text: "0";
                    font-family: command.font-family;
                    font-size: command.font-size;
                }
                // The viewport moves up, below zero, as the command scrolls.
                property <int> hidden-lines: ceil((command.preferred-height + code.content-y - code.height) / line.preferred-height);
                // The full command must be read before it is allowed, so say what is cut off.
                if self.hidden-lines > 0: Rectangle {
                    y: parent.height - self.height;
                    height: 34px;
                    background: @linear-gradient(180deg, Theme.code-surface.transparentize(100%) 0%, Theme.code-surface 75%);

                    Text {
                        x: parent.width - self.width - 12px;
                        y: parent.height - self.height - 6px;
                        text: code-box.hidden-lines == 1 ? "+1 line" : "+\{code-box.hidden-lines} lines";
                        color: Theme.muted;
                        font-family: Theme.font;
                        font-size: Theme.size-small;
                        font-weight: 600;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                LinkButton {
                    label: "Open in app";
                    clicked => {
                        root.decide(root.request-id, Choice.ask-in-app);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.shortcuts: Label {
                    text: "Ctrl+Alt+Y or N";
                    font-size: Theme.size-small;
                }
                PillButton {
                    label: "Deny";
                    armed: root.request-armed;
                    progress: root.arming;
                    clicked => {
                        root.answer(Choice.deny);
                    }
                }
                PillButton {
                    label: "Allow";
                    primary: true;
                    armed: root.request-armed;
                    progress: root.arming;
                    clicked => {
                        root.answer(Choice.allow);
                    }
                }
            }
        }

        alert-view := HorizontalLayout {
            opacity: 0;
            visible: self.opacity > 0;
            alignment: center;
            spacing: 9px;
            padding-left: 18px;
            padding-right: 18px;
            accessible-role: button;
            accessible-label: root.alert-text;
            accessible-action-default => {
                root.alert-clicked();
            }

            Logo {
                provider: root.alert-provider;
                fill: root.alert-mark;
            }
            Value {
                text: root.alert-text;
                overflow: elide;
            }
        }

        // Above the hover area, so a click on an alert focuses its session.
        TouchArea {
            enabled: root.alert-active && !root.has-request;
            clicked => {
                root.alert-clicked();
            }
        }

        states [
            request when root.has-request: {
                pill.width: root.request-width;
                pill.height: root.request-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                request-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate request-view.opacity { duration: 140ms; delay: 160ms; }
                }
                out {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
                    animate request-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            alert when root.alert-active: {
                pill.width: root.alert-width;
                pill.height: root.alert-height;
                idle-row.opacity: 0;
                detail.opacity: 0;
                alert-view.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 220ms; easing: ease-out; }
                    animate idle-row.opacity, detail.opacity { duration: 80ms; }
                    animate alert-view.opacity { duration: 140ms; delay: 140ms; }
                }
                out {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
                    animate alert-view.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            tucked when root.tucked: {
                idle-row.opacity: 0;
                in {
                    animate idle-row.opacity { duration: 80ms; }
                }
                out {
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
            open when root.expanded: {
                pill.width: root.drawn-open-width;
                pill.height: root.drawn-open-height;
                idle-row.opacity: 0;
                detail.opacity: 1;
                in {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
                    animate idle-row.opacity { duration: 80ms; }
                    animate detail.opacity { duration: 140ms; delay: 100ms; }
                }
                out {
                    animate pill.width, pill.height { duration: Theme.reduce-motion ? 0ms : 200ms; easing: ease-out; }
                    animate detail.opacity { duration: 80ms; }
                    animate idle-row.opacity { duration: 140ms; delay: 120ms; }
                }
            }
        ]
    }
}
